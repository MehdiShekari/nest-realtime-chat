{
  "name": "realtime-chat",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @realtime-chat/api",
    "dev:web": "npm run dev -w @realtime-chat/web",
    "build": "npm run build -w @realtime-chat/shared && npm run build -w @realtime-chat/api && npm run build -w @realtime-chat/web",
    "test": "npm run test -w @realtime-chat/api",
    "test:e2e": "npm run test:e2e -w @realtime-chat/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "npm run db:migrate -w @realtime-chat/api",
    "db:seed": "npm run db:seed -w @realtime-chat/api",
    "db:studio": "npm run db:studio -w @realtime-chat/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2"
  }
}