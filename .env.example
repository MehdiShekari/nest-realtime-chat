# ---------- Runtime ----------
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=realtime_chat
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chat:chat@localhost:5432/realtime_chat?schema=public

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000